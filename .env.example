# Base URL of the Directus CMS that feeds the Selected Work grid (#works).
# Leave UNSET in prod: the site defaults to the same-origin "/directus" path,
# which nginx proxies to the Directus container (see nginx.conf) — no CORS or
# public CMS subdomain needed. Set this only to point at a different/absolute
# Directus (e.g. a local instance during dev). Empty base disables the grid
# (neutral placeholder tiles).
# VITE_DIRECTUS_URL=/directus

# Analytics is opt-in: no script is loaded until a provider ID is set.
# Recommended permanent layer: self-hosted Umami.
# Example: VITE_UMAMI_SRC=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=
# Optional: keep personalized `?to=...` links out of pageview URLs.
VITE_UMAMI_EXCLUDE_SEARCH=true
VITE_UMAMI_RESPECT_DNT=true
# VITE_UMAMI_DOMAINS=darling.design,www.darling.design
# VITE_UMAMI_TAG=portfolio
# VITE_UMAMI_HOST_URL=https://analytics.example.com
# VITE_UMAMI_PERFORMANCE=false

# Optional behavioral layer: Microsoft Clarity.
# Enable only after adding the project id and checking privacy/consent needs.
# VITE_CLARITY_PROJECT_ID=
# Set to false to hide the notice while Clarity stays in cookieless mode.
# VITE_ANALYTICS_CONSENT_NOTICE=true

# Local debugging: logs events to the console without requiring a provider.
# VITE_ANALYTICS_DEBUG=true
# VITE_ANALYTICS_DISABLED=true
