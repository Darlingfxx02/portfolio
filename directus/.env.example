# Copy into Coolify → Directus resource → Environment Variables.
# Generate secrets with:  openssl rand -hex 32

# Directus crypto — random, keep stable once set (rotating logs everyone out).
DIRECTUS_KEY=replace-with-openssl-rand-hex-32
DIRECTUS_SECRET=replace-with-openssl-rand-hex-32

# First-run admin login (used once to bootstrap; change the password after).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Postgres
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=replace-with-a-strong-password

# Public URL of Directus (the Coolify domain for THIS resource).
PUBLIC_URL=https://cms.darlingdesign.pro

# Origin(s) of the portfolio allowed to call the API. Comma-separate if several.
CORS_ORIGIN=https://darlingdesign.pro
