+// Rendering and image warm-up finish asynchronously. A map belongs only to
+// the geometry that requested it, never to the latest box by coincidence.
+export function commitCurrentMaterialMaps(surface, key, geometry, maps) {
+  if (surface.wanted !== key || surface.key !== key) return false;
+  surface.maps = maps;
+  surface.shown = geometry;
+  surface.error = undefined;
+  return true;
+}
